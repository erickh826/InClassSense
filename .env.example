# ─── Vercel Serverless Function environment variables ───────────────────────
# Set these in Vercel project settings (Settings → Environment Variables).
# Do NOT use VITE_ prefix — these must stay server-side and never reach the browser.

LLM_API_URL=https://YOUR_RESOURCE.openai.azure.com
LLM_API_KEY=your-azure-api-key-here
LLM_DEPLOYMENT=gpt-4o
LLM_API_VERSION=2024-12-01-preview

# ─── Local development (Vite dev server proxy) ──────────────────────────────
# Copy to .env.local for local dev. Same keys work because vite.config.ts
# reads process.env (not import.meta.env) for the proxy configuration.
