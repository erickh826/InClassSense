# ─── Vercel Serverless Function environment variables ───────────────────────
# Set ALL of these in Vercel project settings (Settings → Environment Variables).
# Do NOT use VITE_ prefix — these must stay server-side and never reach the browser.

# ── Azure OpenAI (chat / report generation) ─────────────────────────────────
LLM_API_URL=https://YOUR_RESOURCE.openai.azure.com
LLM_API_KEY=your-azure-openai-api-key
LLM_DEPLOYMENT=gpt-4o
LLM_API_VERSION=2024-12-01-preview

# ── Azure AI Speech (transcription — /api/transcribe) ───────────────────────
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastasia

# ── Google Gemini (YouTube analysis — /api/analyse) ─────────────────────────
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_MODEL=gemini-2.5-pro

# ─── Local development only ──────────────────────────────────────────────────
# Copy this file to .env.local for local dev.
# .env.local is gitignored and safe to put real keys in.
